//@version=5
indicator("ATR Risk Manager", shorttitle="ATR Risk", overlay=true)

atrLen   = input.int(14, "ATR length", minval=1)
atrMult  = input.float(2.0, "ATR multiplier", minval=0.5, step=0.1)
minStop  = input.float(5.0, "Min stop, pips", minval=1.0, step=0.5)
maxStop  = input.float(12.0, "Max stop, pips", minval=1.0, step=0.5)
deposit  = input.float(100000, "Deposit", minval=0.0)
riskPct  = input.float(1.0, "Risk per trade, %", minval=0.1, step=0.1)
pipValue = input.float(830, "Pip value per 1 lot", minval=0.01)
pipSize  = input.float(0.0001, "Pip size", minval=0.00001, step=0.00001)

atrVal   = ta.atr(atrLen)
rawStop  = atrVal / pipSize * atrMult
stopPips = math.min(math.max(rawStop, minStop), maxStop)
riskMoney = deposit * riskPct / 100
lotSize  = riskMoney / (stopPips * pipValue)

stopLong  = close - stopPips * pipSize
stopShort = close + stopPips * pipSize

plot(stopLong, "Stop for long", color=color.new(color.green, 0))
plot(stopShort, "Stop for short", color=color.new(color.red, 0))

var table info = table.new(position.top_right, 2, 5, border_width=1)

if barstate.islast
    table.cell(info, 0, 0, "ATR", text_color=color.gray)
    table.cell(info, 1, 0, str.tostring(atrVal / pipSize, "#.##") + " p", text_color=color.white)
    table.cell(info, 0, 1, "Stop", text_color=color.gray)
    table.cell(info, 1, 1, str.tostring(stopPips, "#.#") + " p", text_color=color.white)
    table.cell(info, 0, 2, "Lot", text_color=color.gray)
    table.cell(info, 1, 2, str.tostring(lotSize, "#.##"), text_color=color.white)
    table.cell(info, 0, 3, "Risk", text_color=color.gray)
    table.cell(info, 1, 3, str.tostring(riskMoney, "#") + " RUB", text_color=color.white)
    table.cell(info, 0, 4, "Target 2R", text_color=color.gray)
    table.cell(info, 1, 4, str.tostring(stopPips * 2, "#.#") + " p", text_color=color.white)
